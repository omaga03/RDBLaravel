APP_NAME="ระบบฐานข้อมูลงานวิจัย มรภ.เพชรบูรณ์ (PCRU RDB)"
APP_ENV=local
APP_KEY=base64:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx=
APP_DEBUG=false  # ✅ ปิด DEBUG=false เสมอเมื่อนำขึ้น Production Server
APP_URL=http://laravel_rdb.test

APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=th_TH

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==========================================
# 1. การตั้งค่าฐานข้อมูลหลัก (MariaDB / MySQL)
# ==========================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rdbpcru
DB_USERNAME=root
DB_PASSWORD=

# ==========================================
# 2. ระบบจัดการ Session, Cache และ Queue
# ==========================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ==========================================
# 3. ระบบส่งอีเมล (SMTP / Google Workspace / Log)
# สำหรับส่งรหัสความปลอดภัย OTP 6 หลัก และการแจ้งเตือนวงจรงานวิจัย
# ==========================================
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="research@pcru.ac.th"
MAIL_FROM_NAME="${APP_NAME}"

# ==========================================
# 4. ระบบยืนยันตัวตน Google Workspace SSO (@pcru.ac.th)
# ==========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# ==========================================
# 5. ระบบแจ้งเตือนผ่าน Telegram Bot (Admin & Researchers)
# ==========================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_NOTIFICATIONS_ENABLED=true
TELEGRAM_TIMEOUT=4

# ==========================================
# 6. การเชื่อมต่อฐานข้อมูลวิชาการและระบบภายนอก (Scopus, NRIIS, Facebook)
# ==========================================
SCOPUS_API_KEY=
SCOPUS_INST_TOKEN=
MAKE_WEBHOOK_URL=
FACEBOOK_PAGE_URL="https://www.facebook.com/rdi.pcru"

# ==========================================
# 7. พาธไบนารีระบบและการตั้งค่า Git Sync (ระบุเฉพาะกรณีไม่ได้อยู่ใน PATH มาตรฐาน)
# ==========================================
# PDFTOTEXT_PATH="/usr/bin/pdftotext"
# PYTHON_PATH="/usr/bin/python3"
# MYSQLDUMP_PATH="/usr/bin/mysqldump"
# MYSQL_PATH="/usr/bin/mysql"
# GIT_PATH="/usr/bin/git"
GIT_AUTHOR_NAME="PCRU Admin"
GIT_AUTHOR_EMAIL="omaga03@gmail.com"

VITE_APP_NAME="${APP_NAME}"
